# Copy to .env.local (git-ignored), fill in, and the Makefile's tf-* targets source it.
# Credentials never go in Terraform variables: AWS_PROFILE is read by the provider.
export AWS_PROFILE=REPLACE_WITH_PROFILE
export TF_VAR_aws_account_id=REPLACE_WITH_ACCOUNT_ID
export TF_VAR_aws_region=us-west-2
# export TF_VAR_instance_type=t4g.micro

# Existing state bucket (not created by this stack).
export TF_STATE_BUCKET=REPLACE_WITH_BUCKET
export TF_STATE_KEY=nba-sim/prod/terraform.tfstate
export TF_STATE_REGION=us-west-2
